# Keep the deployment lean: ship the site, the API and the framework package only.

# Sandbox / tooling state (never deploy these)
.cline-home
.vercel
.git
.github
.gitignore
.vercelignore
__pycache__
*.pyc
*.egg-info
build
dist
uv.lock

# IMPORTANT: pyproject.toml + requirements.txt are excluded so the staged deploy
# is a plain static site. NOTE: .vercelignore alone does NOT stop Vercel from
# detecting the repo as a Python app when these files ARE present (the Git
# integration deploys the whole tree, ignoring this file for detection); the
# real guard is "framework": null in vercel.json. Keep both.
pyproject.toml
requirements.txt

# Repo extras not needed at runtime
tests
examples
docs
configs
data
runs
scripts
*.md
LICENSE
